#!/usr/bin/env bash
# aw-config — read one key from the repo's .claude/agent-workflow.yaml.
#
#   aw-config <key> [default]   print the value, else the default (exit 0)
#   aw-config --marker          print the marker's path; exit 1 when the repo has none
#   aw-config --slug [remote]   print owner/repo for a remote (default: origin, else the first remote)
#
# The marker is a flat "key: value" file. Searched at the current worktree's top
# level, then the master worktree (the parent of the common git dir).
set -euo pipefail

marker() {
  local top common d
  top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  common="$(git rev-parse --git-common-dir 2>/dev/null || true)"
  [ -n "$common" ] && common="$(cd "$common" 2>/dev/null && pwd)" && common="${common%/.git}"
  for d in "$top" "$common"; do
    [ -n "$d" ] && [ -f "$d/.claude/agent-workflow.yaml" ] && { printf '%s\n' "$d/.claude/agent-workflow.yaml"; return 0; }
  done
  return 1
}

slug() {
  local r="${1:-}" url
  [ -n "$r" ] || r="$(git remote | grep -x origin || git remote | head -1)"
  [ -n "$r" ] || return 1
  url="$(git remote get-url "$r" 2>/dev/null)" || return 1
  printf '%s\n' "$url" | sed -E 's|\.git/?$||; s|/$||; s|^.*[:/]([^/:]+/[^/:]+)$|\1|'
}

case "${1:-}" in
  --marker) marker ;;
  --slug) slug "${2:-}" ;;
  ""|-h|--help) sed -n '2,9p' "$0"; exit 2 ;;
  *)
    key="$1"; def="${2:-}"; v=""
    if m="$(marker)"; then
      v="$(sed -n -E "s/^${key}:[[:space:]]*//p" "$m" | head -1 | sed -E 's/[[:space:]]+#.*$//; s/^["'\'']//; s/["'\'']$//; s/[[:space:]]+$//')"
    fi
    printf '%s\n' "${v:-$def}"
    ;;
esac
